            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only patients in this tier",
              "title": "Tier"
            },
            "description": "Only patients in this tier"
          },
          {
            "name": "has_tasks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
